#!/usr/bin/env bash
# vlcmd — the Docker CLI, pointed at the Velox engine instead of Docker Desktop.
#
# Velox deliberately does NOT take over the `docker` command, so it can coexist
# with an existing Docker install. Use vlcmd exactly like docker:
#   vlcmd ps -a
#   vlcmd run --rm hello-world
#   vlcmd network create mynet
#   vlcmd compose up
set -euo pipefail

VELOX_SOCK="${VELOX_SOCK:-$HOME/.velox/docker.sock}"

if ! command -v docker >/dev/null 2>&1; then
    echo "vlcmd: the 'docker' CLI is required on PATH (e.g. 'brew install docker')." >&2
    exit 127
fi
if [ ! -S "$VELOX_SOCK" ]; then
    echo "vlcmd: Velox engine socket not found at $VELOX_SOCK." >&2
    echo "       Start the engine first:  velox start" >&2
    exit 1
fi

exec docker -H "unix://$VELOX_SOCK" "$@"
