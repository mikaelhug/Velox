# Velox — SINGLE SOURCE OF TRUTH for every version number in the project.
#
# Edit versions here, then:
#   ./Scripts/build.sh        # regenerates Sources/Velox/Support/Versions.swift
#   ./Scripts/make-guest.sh   # renders guest/velox.yml from guest/velox.yml.tmpl
#
# Nothing else in the repo should hard-code a version. See CLAUDE.md.
# Shell-sourceable (KEY=VALUE, no spaces) so every script and the Swift codegen
# read the exact same values.

# --- Velox itself ---
VELOX_VERSION=0.1.0
# GitHub repo the updater checks for new releases (owner/name).
VELOX_GITHUB_REPO=mikaelhug/Velox

# --- Guest OS: the Linux kernel (the VM's "OS version") ---
# Velox builds its OWN bare, fast arm64 kernel straight from kernel.org source
# (no LinuxKit), under full config control — an OrbStack-style "macvirt" kernel.
# Scripts/build-kernel.sh fetches this exact tarball, verifies the SHA-256 below,
# and compiles an uncompressed arch/arm64/boot/Image that VZLinuxBootLoader boots
# directly. Bump = edit these three lines (get the sum from the signed
# https://cdn.kernel.org/pub/linux/kernel/v6.x/sha256sums.asc).
KERNEL_ORG_SERIES=6.18
KERNEL_ORG_VERSION=6.18.34
KERNEL_ORG_SHA256=640c4732fb42842166db97e032c1fe7e5ff72c85a8982c75b40f74be3555d760

# --- LinuxKit system packages ---
INIT_IMAGE=linuxkit/init:b5506cc74a6812dc40982cacfd2f4328f8a4b12a
RUNC_IMAGE=linuxkit/runc:9442aa234715e751a16144f1d4ae3fd1a00fd492
CONTAINERD_IMAGE=linuxkit/containerd:ba19f64efd3331a8fd0a33e00eabd14f6ee1780e
GETTY_IMAGE=linuxkit/getty:a86d74c8f89be8956330c3b115b0b1f2e09ef6e0
RNGD_IMAGE=linuxkit/rngd:984eb580ecb63986f07f626b61692a97aacd7198
FORMAT_IMAGE=linuxkit/format:4f779c0b0d0ba145b7f03211b5cbf59fbbe12e54
MOUNT_IMAGE=linuxkit/mount:bd1c3bb45e48e68e47a9456d1669f7119f855184
DHCPCD_IMAGE=linuxkit/dhcpcd:b87e9ececac55a65eaa592f4dd8b4e0c3009afdb
ACPID_IMAGE=linuxkit/acpid:dbd30b25903bf17042c22171b729f94c4bd3d98d
# Small userspace image used for the settime/VirtioFS/Rosetta onboot steps.
ALPINE_IMAGE=alpine:3.23

# --- Docker Engine (dockerd) running inside the guest ---
# Docker 29 makes the containerd image store the default (Velox already opts in
# explicitly — see guest/velox.yml.tmpl).
DIND_IMAGE=docker:29-dind

# --- vsock-relay build toolchain (guest binary) ---
# The relay's Go module deps (incl. golang.org/x/sys) are pinned in
# guest/pkg/vsock-relay/go.mod.
GO_BUILD_IMAGE=golang:1.26-alpine
