# Velox kernel config FRAGMENT — the only knobs we turn ON over `tinyconfig`.
#
# Strategy: start from nothing (`make tinyconfig`), merge THIS additive fragment,
# then `make olddefconfig`. Every `=y` here is something Velox deliberately needs
# to boot under Apple Virtualization.framework and host stock dockerd — so the
# final config is auditable and provably bare (no physical-HW drivers, no debug,
# no tracing). Scripts/build-kernel.sh asserts the critical symbols actually stuck
# after olddefconfig and runs moby's check-config.sh; never trust a raw append.
#
# Symbol names verified against the kernel's own Kconfig. Note CONFIG_VIRTIO_VSOCKETS
# (the guest transport) — NOT CONFIG_VIRTIO_VSOCK.

# --- Core / "expert" syscalls that tinyconfig (CONFIG_EXPERT=y) turns off ---
# containerd/dockerd and ordinary userspace need these back.
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_FUTEX=y
CONFIG_AIO=y
CONFIG_SHMEM=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# CRITICAL: flock()/fcntl() POSIX locks. tinyconfig drops FILE_LOCKING, which
# makes every lock return ENOSYS ("Function not implemented") — that breaks
# dhcpcd's pidfile and, fatally, containerd/dockerd's bbolt metadata store.
CONFIG_FILE_LOCKING=y
# Other EXPERT-gated syscalls the Go runtime + containerd/runc/dockerd expect;
# without them they fall back noisily or fail. Enable to avoid further ENOSYS.
CONFIG_FHANDLE=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_IO_URING=y
# inotify/fanotify: dockerd's cgroup event monitor needs inotify, and countless
# container workloads (file watchers, hot-reload dev servers) do too. tinyconfig
# drops both → inotify_init returns ENOSYS.
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y

# --- SMP + tickless idle + throughput-tuned scheduling (VM workload) ---
CONFIG_SMP=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_100=y
CONFIG_PREEMPT_NONE=y
# Leave CONFIG_MODULES off → fully monolithic, no /lib/modules, no depmod.

# --- PCIe root complex Apple VZ presents (generic ECAM) + virtio-over-PCI ---
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
# Belt-and-suspenders: harmless if VZ never presents an MMIO transport.
CONFIG_VIRTIO_MMIO=y

# --- The virtio devices the Swift host attaches (VMConfiguration.swift) ---
# tinyconfig turns the block layer + the BLK_DEV / NETDEVICES menus OFF, which
# would silently drop virtio-blk/net, ext4 and veth — turn the gates back on.
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_NETDEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- vsock control channel (VZVirtioSocketDevice). EXACT name matters. ---
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y

# --- VirtioFS directory shares (/Users, extra shares, Rosetta) ---
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y

# --- Rosetta x86-64: runs IN-GUEST via binfmt_misc + the rosetta virtiofs share ---
CONFIG_BINFMT_MISC=y

# NOTE: there is deliberately NO initramfs support here. Velox boots the erofs
# root directly off /dev/vda (root=/dev/vda rootfstype=erofs, init=/sbin/vinit),
# so CONFIG_BLK_DEV_INITRD and the RD_* decompressors are intentionally omitted —
# every byte the kernel doesn't carry is a byte of boot time and RAM saved.

# --- Console usable by VZ (console=hvc0 → virtio-console) + printk ---
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_PRINTK=y

# --- Read-only root: erofs (compressed, demand-paged from /dev/vda) ---
# Velox's root filesystem is a compressed read-only erofs image on a virtio-blk
# disk, mounted directly by the kernel (root=/dev/vda rootfstype=erofs, no
# initramfs). Built-in (=y) so the kernel can mount root with no modules. lz4 is
# the fast default; zstd gives a smaller image — both enabled, picked at mkfs time.
# erofs lives under the MISC_FILESYSTEMS menu, which tinyconfig turns off — gate it on.
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_ZSTD=y

# --- Swap: a disk-backed swapfile on the data disk (Resources › Swap setting) ---
# vinit creates a swapfile under /var/lib/docker and swapon()s it when the host
# requests swap via velox.swap=<MiB>. tinyconfig leaves SWAP off, so gate it on.
CONFIG_SWAP=y

# --- Filesystems: ext4 data disk, overlayfs (containerd snapshotter), pseudo-FS ---
CONFIG_EXT4_FS=y
# Container image layers carry security.capability xattrs (file caps) and POSIX
# ACLs; without the ext4 security/ACL xattr handlers, getxattr returns ENOTSUP and
# every `docker build` / image-diff on the containerd store fails. Required.
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Networking core + bridge/veth for the docker bridge ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_SYSVIPC=y
CONFIG_BRIDGE=y
CONFIG_VETH=y
CONFIG_BRIDGE_NETFILTER=y

# --- Netfilter: nftables backend ONLY (no legacy iptables tables) ---
# dockerd runs with --firewall-backend=nftables and writes nf_tables rules
# natively. The legacy xtables table modules (iptable_nat/filter/mangle/raw and
# their ip6 + *_LEGACY gates) are deliberately gone — leaner, faster kernel, and
# the modern path every current distro + Docker is moving to. nft_compat is kept
# so iptables-nft (the dind default) also works as a fallback; it and the xt
# match/target framework are part of the modern nft stack, not legacy.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_MASQUERADE=y
# nftables core + IPv4/IPv6/inet families + the expressions Docker's nat/filter
# chains use (nat, masquerade, conntrack, reject).
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_COMPAT=y
# Expressions Docker 29's NATIVE nftables firewall backend emits directly
# (--firewall-backend=nftables): `fib daddr type local` (route/local-address match)
# and `redir` (for the 127.0.0.11 embedded-DNS redirect). Required — without fib the
# bridge driver fails to register. (Inline `counter` is part of nf_tables core.)
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_REDIR=y
# xt match/target framework + nft_compat. The GUEST firewall no longer needs this
# (dockerd uses the native nftables backend above, and the iptables binary is gone
# from the rootfs), but it's kept for CONTAINER workloads: images that run their own
# `iptables`/`ip6tables` (kube-proxy, network tools, …) rely on the shared kernel's
# xt/compat support, which lives here even though their userspace binary ships in
# the image, not the guest.
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y

# --- Namespaces (all of them) ---
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_USER_NS=y

# --- cgroup v2 with ALL controllers dockerd/containerd expect ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y

# --- Misc container prerequisites ---
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
