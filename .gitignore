# ---- Swift Package Manager ----
.build/
.swiftpm/
Package.resolved

# ---- Xcode (if ever opened there) ----
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
*.xcuserstate

# ---- Velox generated artifacts ----
# Kernel Image built from source by Scripts/build-kernel.sh
Assets/velox-vmlinux
# Guest build outputs (erofs root.img + intermediate rootfs.tar), by make-guest.sh
guest/build/
# VM disk images
*.img
*.raw

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride
Icon?

# ---- Editor / misc ----
*.swp
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json

# ---- Logs / scratch ----
*.log

# ---- Velox.app bundle + release artifacts (built by Scripts/build-app.sh) ----
/Velox.app/
/dist/
/guest/vinit/target/

# ---- Benchmark scratch (generated by docs/bench/run.sh) ----
/docs/bench/smallfiles.tar
